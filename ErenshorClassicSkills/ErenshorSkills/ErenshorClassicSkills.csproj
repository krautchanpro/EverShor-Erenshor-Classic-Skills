<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ErenshorClassicSkills</AssemblyName>
    <RootNamespace>ErenshorSkills</RootNamespace>
    <Version>1.9.2</Version>
    <LangVersion>latest</LangVersion>
    <ReferenceDirectory Condition="'$(ReferenceDirectory)' == ''">lib</ReferenceDirectory>
  </PropertyGroup>

  <!--
    BUILD INSTRUCTIONS (native Lunaris):
    1. Place Lunaris.dll and the game/Unity reference assemblies in $(ReferenceDirectory)/.
    2. Keep 0Harmony.dll as a compile-time reference from the current Lunaris release.
    3. Run dotnet build -c Release.
    4. Install the output DLL in Erenshor/plugins/. Do not bundle Lunaris.dll or
       0Harmony.dll: the Lunaris runtime supplies them.
  -->

  <ItemGroup>
    <Reference Include="Lunaris">
      <HintPath>$(ReferenceDirectory)\Lunaris.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ReferenceDirectory)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ReferenceDirectory)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ReferenceDirectory)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ReferenceDirectory)/UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ReferenceDirectory)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ReferenceDirectory)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ReferenceDirectory)/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ReferenceDirectory)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ReferenceDirectory)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Embed all icons, VFX textures, animations, and models in the DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\**\*.png" />
    <!-- Extra Settings uses Erenshor's native Options_eq_icon_r sprite. -->
    <EmbeddedResource Remove="Resources\Icons\ExtraSettingsMenu.png" />
    <EmbeddedResource Include="Resources\Vfx\**\*.png" />
    <EmbeddedResource Include="Resources\Audio\**\*.wav" />
    <EmbeddedResource Include="Resources\Audio\**\*.md" />
    <EmbeddedResource Include="Resources\Models\**\*" />
    <EmbeddedResource Include="Resources\Animations\**\*" />
  </ItemGroup>

</Project>
